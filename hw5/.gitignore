.venv/
venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
.mypy_cache/

# Node / Vite
node_modules/
frontend/dist/
frontend/node_modules/
*.tsbuildinfo

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
